digraph AIEFlashStreamV21 {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.35",
    ranksep="0.65",
    fontname="DejaVu Sans",
    fontsize=22,
    label="AIE-FlashStream — Final V21 PV6 Architecture\nLlama3-8B causal GQA: S=32, HQ=32, HKV=8, D=128, GQA 4:1",
    labelloc=t,
    splines=ortho
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, color="#1e3a8a", penwidth=1.8, margin="0.16,0.10"];
  edge [color="#475569", penwidth=1.8, arrowsize=0.8, fontname="DejaVu Sans", fontsize=11];

  input [label="BF16 Q / K / V", fillcolor="#f8fafc"];
  output [label="BF16 O\n[B, HQ, S, 128]", fillcolor="#f8fafc"];

  subgraph cluster_pl_in {
    label="PL preprocessing";
    color="#2563eb";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#eff6ff";
    quant [label="Q/K → INT8\nquantization", fillcolor="#dbeafe"];
    packet [label="packetization\nstream scheduling", fillcolor="#dbeafe"];
    phases [label="two-phase controller\nphase 0: Q0/Q1 + load K/V\nphase 1: Q2/Q3 + reuse K/V", fillcolor="#ede9fe", color="#7c3aed"];
    { rank=same; quant; packet; phases; }
    quant -> packet -> phases;
  }

  subgraph cluster_aie {
    label="AIE array: 8 GQA groups × 8 tiles = 64 compute tiles";
    color="#1e3a8a";
    penwidth=2.2;
    style="rounded,filled";
    fillcolor="#f8fafc";

    groups [
      shape=record,
      label="{G0|G1|G2|G3|G4|G5|G6|G7}|{each: 1 Score + 1 Softmax + 6 PV}",
      fillcolor="#e0e7ff",
      color="#4338ca",
      fontsize=12
    ];

    score [label="1 Score tile\nINT8 QK\nINT32 accumulate", fillcolor="#fef3c7", color="#d97706"];
    softmax [label="1 Softmax tile\nFP32", fillcolor="#dcfce7", color="#16a34a"];
    pv [label="6 PV tiles\nFP32 accumulation\n24 / 24 / 16 | 24 / 24 / 16\noffsets 0 / 24 / 48 / 64 / 88 / 112", fillcolor="#fce7f3", color="#db2777"];
    cache [label="tile-local K/V cache\nload in phase 0 • reuse in phase 1", fillcolor="#ede9fe", color="#7c3aed"];
    placement [label="per-group placement\nrow 1: Score, PV5, PV4, Softmax\nrow 2: PV3, PV2, PV1, PV0", fillcolor="#ffffff", color="#64748b"];

    groups -> score [label="representative group"];
    { rank=same; score; softmax; pv; }
    { rank=same; cache; placement; }
    score -> softmax;
    softmax -> pv;
    cache -> score [label="K"];
    cache -> pv [label="V"];
    pv -> placement [style=dashed, arrowhead=none];
  }

  subgraph cluster_pl_out {
    label="PL reconstruction";
    color="#9333ea";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#faf5ff";
    collect [label="depacketize\nsix-slice collector", fillcolor="#f3e8ff"];
    planes [label="four contiguous\n32-D output planes", fillcolor="#f3e8ff"];
    { rank=same; collect; planes; }
    collect -> planes;
  }

  plio [label="Physical PLIO = 16\n2 Q + 2 K + 6 V + 6 O\nQ/K split across 8 groups • V split8 • O merge8", fillcolor="#f1f5f9", color="#475569"];

  input -> quant;
  phases -> groups [label="2Q + 2K + 6V"];
  placement -> collect [label="6 O streams"];
  planes -> output;
  phases -> plio [style=dashed, arrowhead=none];
  plio -> collect [style=dashed, arrowhead=none];
}
